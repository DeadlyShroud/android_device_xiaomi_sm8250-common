#Allow XiaomiParts to read/write to vendor_sysfs_touch;
allow devicesettings_app vendor_sysfs_touch:file rw_file_perms;

# Allow devicesettings_app to find hal_touchfeature_xiaomi_hwservice
allow devicesettings_app hal_touchfeature_xiaomi_hwservice:hwservice_manager find;

# Allow binder communication with hal_touchfeature_xiaomi_default
binder_call(devicesettings_app, hal_touchfeature_xiaomi_default)

# Allow devicesettings_app to write to sysfs_graphics
allow devicesettings_app vendor_sysfs_graphics:file write;
r_dir_file(devicesettings_app, vendor_sysfs_graphics)

# Miui Sepolicy for Vendor Audio Files
allow devicesettings_app vendor_audio_data_file:dir {write add_name search};
allow devicesettings_app vendor_audio_data_file:file {read write create getattr append open};

# Allow devicesettings_app to r/w livedisplay_tuneable
allow devicesettings_app sysfs_livedisplay_tuneable:file rw_file_perms;

# XiaomiParts checks the HAL Hi-Fi capability before exposing its control.
get_prop(devicesettings_app, vendor_audio_prop)

# Allow devicesettings_app to operate with vendor_sysfs_graphics
allow devicesettings_app vendor_sysfs_graphics:dir search;
allow devicesettings_app vendor_sysfs_graphics:file rw_file_perms;

# Allow devicesettings_app to access battery sysfs for charge bypass
allow devicesettings_app vendor_sysfs_battery_supply:dir search;
allow devicesettings_app vendor_sysfs_battery_supply:file rw_file_perms;

# Allow KProfiles to be adjusted by a devicesettings_app
allow devicesettings_app sysfs_kprofiles:file rw_file_perms;

# DisplayFeature
hal_client_domain(devicesettings_app, vendor_hal_displayfeature_xiaomi)
binder_call(devicesettings_app, vendor_hal_displayfeature_xiaomi)

allow devicesettings_app {
  vendor_hal_displayfeature_xiaomi_hwservice
}:hwservice_manager find;
